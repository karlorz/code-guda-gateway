{{DOMAIN}} {
	# OAuth callback codes and consent parameters must not enter access logs.
	@sensitive path /authorize /authorize/* /token /auth/cli/*
	log_skip @sensitive
	handle /internal* {
		respond 404
	}

	handle /mcp* {
		reverse_proxy 127.0.0.1:8800 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy {{LISTEN_ADDR}} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
