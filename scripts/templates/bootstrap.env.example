# Bootstrap-only settings for guda-gateway (no secrets).
# Copy to /etc/code-guda-gateway/bootstrap.env and adjust as needed.
# The gateway reads env vars only — source this file or point systemd EnvironmentFile= at it.
# Placeholders are filled by scripts/install-linux.sh; defaults match production paths.

ADDR={{LISTEN_ADDR}}
DB_PATH={{VAR_DIR}}/gateway.db
GUDA_MASTER_KEY_PATH={{ETC_DIR}}/master.key
GUDA_ADMIN_COOKIE_SECURE=true

# Optional internal loopback bearer verification token for FastMCP. Leave unset if not used.
# GUDA_INTERNAL_TOKEN=change-me-internal-secret

# MCP OAuth for ChatGPT web and Doubao. Both must be set or the routes stay 404.
# Issuer is a public origin with no path. Password hash is scrypt$N$r$p$salt$urlsafe$hash.
# Put the hash in the secrets file, not here. Leave both unset until you intend to enable OAuth.
# GUDA_OAUTH_ISSUER=https://search.karldigi.dev
# GUDA_OAUTH_OPERATOR_PASSWORD_HASH=

# Optional debug attempt logging. Leave disabled in production by default.
# GUDA_PROXY_DEBUG_ATTEMPTS=false
